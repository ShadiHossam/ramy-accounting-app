generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model MonthlyMetric {
  id        String   @id
  sheet     String   @db.VarChar(50)
  category  String   @db.VarChar(200)
  year      Int
  month     Int
  amount    Float
  createdAt DateTime @default(now())

  @@unique([sheet, category, year, month])
  @@index([year, month])
}

model BalanceSheetLine {
  id        String   @id
  label     String   @db.VarChar(300)
  code      String?  @db.VarChar(50)
  section   String   @db.VarChar(20)
  isTotal   Boolean  @default(false)
  amount    Float
  asOfDate  DateTime
  createdAt DateTime @default(now())

  @@index([asOfDate])
}
