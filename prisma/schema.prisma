generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// دليل الحسابات (chart of accounts) — resolved at import time and denormalized onto each
// JournalLine below, so every page reads accountName/accountType without a join.
model Account {
  code       Int      @id
  name       String   @db.VarChar(200)
  type       String   @db.VarChar(20)
  parentCode Int?
  level      Int
  createdAt  DateTime @default(now())
}

// One row of قيود اليومية — the raw ledger. All financial views are computed from this table,
// never from a pre-aggregated/invented bucket.
model JournalLine {
  id             String   @id
  entryNumber    Int
  entryDate      DateTime
  postingDate    DateTime
  refNumber      String   @db.VarChar(100)
  docType        String   @db.VarChar(100)
  description    String   @db.VarChar(500)
  accountCode    Int
  accountName    String   @db.VarChar(200)
  accountType    String   @db.VarChar(20)
  costCenter     String   @db.VarChar(200)
  debit          Float
  credit         Float
  approvalStatus String   @db.VarChar(50)
  createdAt      DateTime @default(now())

  @@index([entryDate])
  @@index([accountCode])
  @@index([costCenter])
}
